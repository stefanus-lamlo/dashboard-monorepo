# Copy to .env and fill in your own key (never commit the real .env file).
OPENAI_API_KEY=

# Optional, defaults to 4000.
PORT=4000

# Optional, defaults to gpt-image-1. All gpt-image-* models require your
# OpenAI organization to complete ID verification before they'll work for
# image generation (platform.openai.com -> Settings -> Organization ->
# Verifications) — you'll get a clear 403 error here until that's done.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional, defaults to gpt-4.1-mini. Used to summarize documents/meeting
# transcripts into structured minutes of meeting (MoM).
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Optional, defaults to gpt-transcribe. Used to transcribe uploaded meeting audio
# (forced to Indonesian). Non-natively-supported audio formats are transcoded to
# mp3 with a bundled ffmpeg binary before upload.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Optional. Unset allows any origin (fine for local dev). In production, set this to
# your web app's real origin, e.g. https://dashboard.example.com
CORS_ORIGIN=

# Optional rate limiting on the OpenAI-backed routes only (images/documents/audio/
# flowchart/learning) - they cost real money per request and there's no auth in front
# of them. Defaults: 20 requests per 15 minutes, per IP. This is a basic safety net
# against runaway bugs/abuse, not real abuse prevention - see README's production notes.
AI_RATE_LIMIT_WINDOW_MINUTES=15
AI_RATE_LIMIT_MAX=20
